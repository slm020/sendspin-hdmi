[Unit]
Description=sendspin-hdmi: kiosk browser on the HDMI screen (sway + Chromium)
After=sendspin-hdmi-web.service
Wants=sendspin-hdmi-web.service

[Service]
ExecStart=/opt/sendspin-hdmi/venv/bin/python /opt/sendspin-hdmi/app/kiosk.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
